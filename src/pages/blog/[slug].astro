---
export const prerender = false;
import { getEditMeta, getEmDashCollection, getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import MainLayout from '@/layouts/main-layout.astro';
import PostBlock from '@/components/blog/PostBlock.astro';
import PostCode from '@/components/blog/PostCode.astro';
import PostImage from '@/components/blog/PostImage.astro';
import { Social } from '@/components/social';
import { getAdjacentPosts } from '@/lib/blog-utils';
import { formatDate } from '@/lib/formatDate';
import { mergeAndSortPosts } from '@/lib/freecodecamp-utils';
import { anchorHeadings } from '@/lib/post-outline';
import { cn } from '@/lib/utils';
import {
  extractBrief,
  mediaValueToUrl,
  normalizeEmdashPosts,
  readingTimeMinutes,
  termsToTags
} from '@/lib/emdash-posts';

const { entry } = await getEmDashEntry('posts', Astro.params.slug as string);
if (!entry) {
  return Astro.rewrite('/404');
}

const { data } = entry;

const { entries: localPosts } = await getEmDashCollection('posts', { status: 'published' });
const { newer, older } = getAdjacentPosts(mergeAndSortPosts(normalizeEmdashPosts(localPosts)), entry.id);

const isEditable = getEditMeta(data.content) !== undefined;
const { content: anchoredContent, outline } = anchorHeadings(data.content ?? []);
const content = isEditable ? (data.content ?? []) : anchoredContent;
const showOutline = !isEditable && outline.length >= 3;

const readingTime = readingTimeMinutes(data);
const brief = extractBrief(data.brief, data.content);
const tags = termsToTags(data.terms);
const publishedAt = new Date(data.date);

const pageTitle = data.seo_title || data.title;
const pageDescription = data.seo_description || brief;

const coverImageUrl = mediaValueToUrl(data.cover);
const pageImage = coverImageUrl;
---

<MainLayout pageTitle={pageTitle} pageDescription={pageDescription} pageImage={pageImage} variant='prose'>
  <article
    class={cn(
      'overflow-hidden',
      'bg-white',
      'no-underline',
      'border-2 border-black',
      'shadow-brutal-lg',
      'transition-all duration-100'
    )}
    data-post
    data-post-slug={entry.id}
  >
    <!-- Cover Image or Fallback -->
    {
      coverImageUrl ? (
        <div class='relative aspect-video w-full' data-post-cover>
          <img
            src={coverImageUrl}
            alt={data.cover?.alt || data.title}
            width={data.cover?.width}
            height={data.cover?.height}
            class='h-full w-full object-cover'
            loading='eager'
            fetchpriority='high'
          />
        </div>
      ) : (
        <div
          class='flex aspect-video items-center justify-center bg-linear-to-br/oklch from-blue-500 via-purple-500 to-pink-500'
          data-post-cover
        >
          <span class='text-6xl'>📝</span>
        </div>
      )
    }

    <!-- Content Container -->
    <div class='p-6 sm:p-10'>
      <!-- Title -->
      <h1 class='text-display-md mb-6 text-gray-900'>
        {data.title}
      </h1>

      <!-- Metadata -->
      <div class='mb-8 flex flex-wrap items-center gap-x-4 gap-y-3'>
        <div class='flex items-center gap-2 text-xs text-gray-600 sm:text-sm'>
          <time datetime={publishedAt.toISOString()}>
            {formatDate(publishedAt)}
          </time>
          <span aria-hidden='true'>•</span>
          <span>{readingTime} min read</span>
        </div>
        {
          tags.length > 0 && (
            <ul aria-label='Tags' class='flex list-none flex-wrap gap-2 p-0'>
              {tags.map((tag) => (
                <li>
                  <a
                    href={`/blog/tags/${tag.slug}`}
                    class='inline-flex items-center rounded-full border-2 border-black bg-white px-3 py-1 text-xs font-semibold text-black no-underline brutalist-focus shadow-brutal-sm transition-all duration-100 hover:bg-orange-100 hover:shadow-brutal-md active:bg-black active:text-white active:shadow-none'
                  >
                    {`#${tag.slug}`}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        showOutline && (
          <details class='mb-8 border-2 border-black bg-orange-50 shadow-brutal-sm [&[open]>summary]:border-b-2 [&[open]>summary]:border-black'>
            <summary class='flex cursor-pointer list-none items-center justify-between px-4 py-3 font-display font-bold text-slate-800 hover:bg-orange-100 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-slate-800 [&::-webkit-details-marker]:hidden'>
              <span>
                On this page
                <span class='ml-2 font-sans text-sm font-normal text-slate-600'>{outline.length} sections</span>
              </span>
              <span aria-hidden='true' class='font-mono text-xl leading-none [details[open]_&]:rotate-45'>
                +
              </span>
            </summary>
            <nav aria-label='On this page'>
              <ol class='my-0 space-y-1.5 py-3 pr-4 pl-9 text-slate-600'>
                {outline.map((section) => (
                  <li>
                    <a href={`#${section.id}`} class='text-slate-800 no-underline hover:bg-orange-100 hover:underline'>
                      {section.text}
                    </a>
                    {section.children.length > 0 && (
                      <ol class='mt-1.5 list-none space-y-1.5 pl-4'>
                        {section.children.map((child) => (
                          <li>
                            <a
                              href={`#${child.id}`}
                              class='text-slate-800 no-underline hover:bg-orange-100 hover:underline'
                            >
                              {child.text}
                            </a>
                          </li>
                        ))}
                      </ol>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        )
      }

      <!-- Post Content with Prose Styling -->
      <div
        class={cn(
          'prose prose-lg max-w-none',
          'prose-p:text-gray-700',
          'prose-p:my-2 prose-p:leading-relaxed',
          'prose-strong:text-gray-800',
          'prose-headings:font-display prose-headings:font-bold prose-headings:text-gray-800 prose-headings:scroll-mt-6',
          'prose-h2:mb-2 prose-h2:mt-8',
          'prose-h3:mb-2 prose-h3:mt-6',
          'prose-h4:mb-2 prose-h4:mt-4',
          'prose-a:text-blue-600 prose-a:no-underline prose-a:hover:underline',
          'prose-ul:list-disc prose-li:text-gray-700',
          'prose-img:my-4 prose-img:rounded-md prose-img:shadow-md',
          'prose-hr:border-gray-200',
          'prose-blockquote:border-l-4 prose-blockquote:border-gray-400 prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-gray-700'
        )}
      >
        <PortableText value={content} components={{ block: PostBlock, type: { code: PostCode, image: PostImage } }} />
      </div>
    </div>
  </article>

  <section class='py-8'>
    {
      (newer || older) && (
        <nav aria-label='More posts' class='mb-8 grid gap-4 sm:grid-cols-2'>
          {older ? (
            <a
              href={`/blog/${older.data.slug}`}
              rel='prev'
              data-astro-prefetch='hover'
              class='group brutalist-card-hover brutalist-focus block px-5 py-4 no-underline'
            >
              <span class='mb-1 block font-display text-xs font-bold tracking-wider text-slate-600 uppercase'>
                <span aria-hidden='true'>←</span> Older
              </span>
              <span class='block font-display font-bold text-slate-900 group-hover:text-orange-800'>
                {older.data.title}
              </span>
            </a>
          ) : (
            <span class='hidden sm:block' />
          )}
          {newer && (
            <a
              href={`/blog/${newer.data.slug}`}
              rel='next'
              data-astro-prefetch='hover'
              class='group brutalist-card-hover brutalist-focus block px-5 py-4 no-underline sm:text-right'
            >
              <span class='mb-1 block font-display text-xs font-bold tracking-wider text-slate-600 uppercase'>
                Newer <span aria-hidden='true'>→</span>
              </span>
              <span class='block font-display font-bold text-slate-900 group-hover:text-orange-800'>
                {newer.data.title}
              </span>
            </a>
          )}
        </nav>
      )
    }
    <div class='flex justify-center'>
      <a
        href='/blog'
        class='brutalist-button-secondary inline-flex h-14 items-center justify-center gap-2 px-6 py-3 text-sm font-bold sm:text-base md:text-lg'
        aria-label='Back to blog'
        data-testid='back-to-blog-button'
      >
        <span aria-hidden='true'>←</span>
        <span>Back to blog</span>
      </a>
    </div>
  </section>

  <section class='pt-4 pb-8'>
    <div class='prose prose-lg prose-slate mx-auto mt-12 max-w-3xl'>
      <h3 class='mb-4 text-center font-bold text-slate-700'>Elsewhere on the internet</h3>
      <Social />
    </div>
  </section>
</MainLayout>
