---
export const prerender = false;
// Dynamic tag page - shows posts filtered by a specific tag
import { getCollection } from 'astro:content';
import { getEmDashCollection } from 'emdash';
import MainLayout from '@/layouts/main-layout.astro';
import BlogSearch from '@/components/blog/BlogSearch';
import BentoGrid from '@/components/blog/BentoGrid';
import { Social } from '@/components/social';
import { getTagBySlug, filterPostsByTag } from '@/lib/blog-utils';
import { normalizeEmdashPosts } from '@/lib/emdash-posts';
import { normalizeFreeCodeCampPosts, mergeAndSortPosts } from '@/lib/freecodecamp-utils';
import type { LightweightPost } from '@/types/blog';

const { entries: localPosts } = await getEmDashCollection('posts', { status: 'published' });
const freecodecampPosts = await getCollection('freecodecamp');

const allPosts = mergeAndSortPosts(
  normalizeEmdashPosts(localPosts),
  normalizeFreeCodeCampPosts(freecodecampPosts)
);

const tag = getTagBySlug(allPosts, Astro.params.tag as string);
if (!tag) {
  return Astro.rewrite('/404');
}
const posts = filterPostsByTag(allPosts, tag.slug);

// Sort posts by date (newest first)
const sortedPosts = posts.sort(
  (a: LightweightPost, b: LightweightPost) =>
    new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

// SEO metadata
const pageTitle = `${tag.name} Posts`;
const pageDescription = `Browse all blog posts tagged with ${tag.name}`;
const canonicalURL = new URL(`/blog/tags/${tag.slug}`, Astro.site).toString();

// Structured data for tag page
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: canonicalURL,
  numberOfItems: posts.length,
  hasPart: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    datePublished: post.data.publishedAt,
    url: new URL(`/blog/${post.data.slug}`, Astro.site).toString()
  }))
};
---

<MainLayout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageUrl={canonicalURL}
  pageImage={posts[0]?.data.coverImage?.url}
>
  <script type='application/ld+json' is:inline set:html={JSON.stringify(structuredData)} />
  <section class='mb-2'>
    <div class='prose prose-lg prose-slate max-w-none'>
      <h1 class='py-4 text-center text-display-md text-slate-800'>
        Posts tagged with "{tag.name}"
      </h1>
    </div>
  </section>

  <section class='mb-12'>
    <div class='mb-6 text-center'>
      <p class='text-base sm:text-lg text-slate-600'>
        {sortedPosts.length}
        {sortedPosts.length === 1 ? 'post' : 'posts'} found
      </p>
    </div>

    {
      sortedPosts.length === 0 ? (
        <div class='mx-auto max-w-md rounded-lg border-2 border-dashed border-slate-300 p-12 text-center'>
          <p class='text-base text-slate-600 sm:text-lg'>No posts found with this tag.</p>
        </div>
      ) : (
        <>
          <BlogSearch posts={allPosts} client:idle />

          <BentoGrid posts={sortedPosts} initialCount={6} postsPerLoad={3} client:visible />

          {/* View All Tags Button */}
          <div class='flex justify-center py-8'>
            <a
              href='/blog/tags'
              class='brutalist-button-secondary inline-flex h-14 items-center justify-center gap-2 px-6 py-3 text-sm font-bold sm:text-base md:text-lg'
              aria-label='View all tags'
            >
              <span aria-hidden='true'>←</span>
              <span>View all tags</span>
            </a>
          </div>
        </>
      )
    }
  </section>
  <section class='pt-4 pb-8'>
    <div class='prose prose-lg prose-slate mx-auto mt-12 max-w-3xl'>
      <h3 class='mb-4 text-center font-bold text-slate-700'>Elsewhere on the internet</h3>
      <Social />
    </div>
  </section>
</MainLayout>
