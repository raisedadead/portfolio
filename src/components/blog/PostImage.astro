---
import { MEDIA_FILE_ROUTE } from '@/lib/emdash-posts';

interface Props {
  node: {
    _type: 'image';
    alt?: string;
    width?: number;
    height?: number;
    asset?: {
      _ref?: string;
      url?: string;
    };
  };
}

const { node } = Astro.props;
const asset = node.asset ?? {};
const key = asset.url || asset._ref;
const src = key ? (/^https?:\/\//.test(key) ? key : `${MEDIA_FILE_ROUTE}/${key}`) : undefined;
---

{src && <img src={src} alt={node.alt ?? ''} width={node.width} height={node.height} loading='lazy' decoding='async' />}
