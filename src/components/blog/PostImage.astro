---
import { MEDIA_FILE_ROUTE } from '@/lib/emdash-posts';

interface Props {
  node: {
    _type: 'image';
    alt?: string;
    width?: number;
    height?: number;
    asset?: {
      _ref?: string;
      url?: string;
    };
  };
}

const { node } = Astro.props;
const asset = node.asset ?? {};
const ref = asset.url || asset._ref;
const src = ref ? (/^(https?:\/\/|\/)/.test(ref) ? ref : `${MEDIA_FILE_ROUTE}/${ref}`) : undefined;
---

{src && <img src={src} alt={node.alt ?? ''} width={node.width} height={node.height} loading='lazy' decoding='async' />}
