{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "[ \"$(git config --local --get core.hooksPath 2>/dev/null)\" != .husky/_ ] || git config --local --unset-all core.hooksPath; vp config --no-agent",
    "dev": "cf dev",
    "develop": "cf dev",
    "build": "pnpm run do:build",
    "preview": "pnpm run do:build && node scripts/snapshot-preview-state.mjs && PORTFOLIO_E2E_STATE_DIR=.cloudflare/preview astro preview --ignore-lock",
    "deploy": "pnpm run do:build && pnpm run do:deploy",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:update": "vp test --update",
    "test:watch:ui": "vp test --ui",
    "test:watch": "vp test",
    "check": "astro check",
    "test:e2e": "pnpm run do:build && playwright test",
    "test:e2e:ui": "pnpm run do:build && playwright test --ui",
    "test:e2e:headed": "pnpm run do:build && playwright test --headed",
    "do:build": "cf build",
    "do:deploy": "cf deploy --prebuilt --force"
  },
  "dependencies": {
    "@ascorbic/feed-loader": "^2.0.1",
    "@astrojs/check": "0.9.12",
    "@astrojs/cloudflare": "15.0.0-beta.5",
    "@astrojs/react": "7.1.8",
    "@calcom/embed-react": "1.5.3",
    "@emdash-cms/cloudflare": "^1.1.0",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@sentry/astro": "11.12.0",
    "@sentry/cloudflare": "11.12.0",
    "@sentry/replay": "11.12.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.11",
    "clsx": "2.1.1",
    "emdash": "^1.1.0",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "shiki": "4.6.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "cf": "1.0.0-beta.29",
    "happy-dom": "21.0.4",
    "jest-axe": "11.0.0",
    "marked": "18.2.0",
    "portless": "0.17.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@12.21.0"
}
