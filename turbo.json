{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "do:build": {
      "dependsOn": ["^do:build"],
      "outputs": ["dist/**", ".astro/**", ".void/preview-deploy-config.json"],
      "env": [
        "NODE_ENV",
        "CI",
        "PUBLIC_SENTRY_DSN",
        "PUBLIC_SENTRY_ENVIRONMENT",
        "PUBLIC_SENTRY_RELEASE",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN"
      ],
      "cache": true
    },
    "do:test": {
      "outputs": [],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:watch:ui": {
      "cache": false,
      "persistent": true
    },
    "test:update": {
      "cache": false,
      "inputs": ["src/**", "vitest.config.ts", "vitest.setup.ts", "tsconfig.json", "package.json"]
    },
    "do:test:coverage": {
      "outputs": ["coverage/**"],
      "cache": true
    },
    "do:lint": {
      "outputs": [],
      "cache": true
    },
    "do:lint:fix": {
      "cache": false,
      "inputs": ["src/**", "e2e/**", ".github/**/*.{js,ts,mjs}", ".oxlintrc.json", "package.json"]
    },
    "do:check": {
      "outputs": [],
      "cache": true
    },
    "do:develop": {
      "cache": false,
      "persistent": true
    },
    "do:preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["do:build"]
    },
    "do:deploy": {
      "dependsOn": ["do:build"],
      "env": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"],
      "passThroughEnv": ["WORKERS_CI*", "WRANGLER_CI*"],
      "cache": false
    },
    "do:versions:upload": {
      "dependsOn": ["do:build"],
      "env": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"],
      "passThroughEnv": ["WORKERS_CI*", "WRANGLER_CI*"],
      "cache": false
    },
    "do:test:e2e": {
      "dependsOn": ["do:build"],
      "inputs": ["e2e/**", "playwright.config.ts"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["CI"],
      "cache": false
    },
    "do:test:e2e:ui": {
      "dependsOn": ["do:build"],
      "cache": false,
      "persistent": true
    },
    "do:test:e2e:headed": {
      "dependsOn": ["do:build"],
      "cache": false
    }
  }
}
